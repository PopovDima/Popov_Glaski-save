<Window x:Class="Popov_Glaski_save.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Popov_Glaski_save"
        mc:Ignorable="d"
        FontFamily="Century Gothic"
        Icon="/res/images/Глазки-save.ico"
        Title="Глазки-save" Height="450" Width="800" MinHeight="450" MinWidth="800">

    <!--FFE9F9 B175EE-->
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Name="GridTop" Background="#FFE9F9">
            <TextBlock Text="Глазки-save" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32"
                       FontWeight="Medium"></TextBlock>
            <Image Source="/res/images/Глазки-save.png" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="10"></Image>
            <Button Name="BtnBack" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="14"></Button>
        </Grid>

        <Frame Name="MainFrame" Grid.Row="1"></Frame>
    </Grid>
</Window>
